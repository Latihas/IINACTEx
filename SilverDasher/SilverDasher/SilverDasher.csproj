<Project Sdk="Dalamud.NET.Sdk/15.0.0">
	<PropertyGroup>
		<AssemblyName>SilverDasher.Core</AssemblyName>
		<RootNamespace>SilverDasher</RootNamespace>
		<Use_DalamudPackager>false</Use_DalamudPackager>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="MQTTnet" Version="5.2.0.1603"/>
		<Reference Include="FFXIV_ACT_Plugin">
			<HintPath>../../external_dependencies/FFXIV_ACT_Plugin.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="FFXIV_ACT_Plugin.Common">
			<HintPath>../../external_dependencies/SDK/FFXIV_ACT_Plugin.Common.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Content Include="SilverDasher.Weaver.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<ProjectReference Include="../../machina/Machina.FFXIV/Machina.FFXIV.csproj"/>
		<ProjectReference Include="../../NotACT/NotACT.csproj"/>
		<ProjectReference Include="../../Unscrambler/Unscrambler/Unscrambler.csproj"/>
	</ItemGroup>
	<PropertyGroup Condition="'$(GITHUB_ACTIONS)' == ''">
		<DalamudLibPath>$(appdata)/XIVLauncherCN/addon/Hooks/dev</DalamudLibPath>
		<AssemblySearchPaths>$(AssemblySearchPaths);$(DalamudLibPath)</AssemblySearchPaths>
	</PropertyGroup>
</Project>