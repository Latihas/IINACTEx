<Project Sdk="Dalamud.NET.Sdk/15.0.0">
	<PropertyGroup>
		<Use_DalamudPackager>false</Use_DalamudPackager>
	</PropertyGroup>
	<ItemGroup>
		<Reference Include="Mono.Cecil">
			<HintPath>$(DalamudLibPath)Mono.Cecil.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="NuGet.Versioning">
			<HintPath>..\..\..\..\.nuget\packages\nuget.versioning\7.9.0\lib\net8.0\NuGet.Versioning.dll</HintPath>
		</Reference>
	</ItemGroup>
	<PropertyGroup Condition="'$(GITHUB_ACTIONS)' == ''">
		<DalamudLibPath>$(appdata)/XIVLauncherCN/addon/Hooks/dev</DalamudLibPath>
		<AssemblySearchPaths>$(AssemblySearchPaths);$(DalamudLibPath)</AssemblySearchPaths>
	</PropertyGroup>
</Project>
